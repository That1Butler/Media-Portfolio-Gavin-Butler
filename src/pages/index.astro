	<body>
		<script>
			// List of Variables
			const YT_API_KEY = "AIzaSyC3ZYtM0Kj1Kt2U5B7ZmbYBtB2YeyRqc_s";
			const CHANNEL_HANDLE = "that1butler";
			const INSTAGRAM_FIXED_VIEWS = 1100000;
			const INSTAGRAM_ACCESS_TOKEN = "YOUR_INSTAGRAM_ACCESS_TOKEN_HERE";
			const INSTAGRAM_MEDIA_ID = "YOUR_REEL_OR_MEDIA_ID_HERE";

			// 1. UI & Scroll Animations Setup
			function initUIInteractions() {
				// Scroll Reveal Observer
				const scrollObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							const isVisible = entry.isIntersecting;
							entry.target.classList.toggle(
								"opacity-100",
								isVisible,
							);
							entry.target.classList.toggle(
								"translate-x-0",
								isVisible,
							);
							entry.target.classList.toggle(
								"opacity-0",
								!isVisible,
							);
							entry.target.classList.toggle(
								"-translate-x-12",
								!isVisible,
							);
						});
					},
					{ threshold: 0.15 },
				);

				document
					.querySelectorAll(".scroll-reveal-left")
					.forEach((el) => {
						scrollObserver.observe(el);
					});

				// Hover Handlers
				const bindHover = (selector, targetBoxId) => {
					const elements = document.querySelectorAll(selector);
					const targetBox = document.getElementById(targetBoxId);

					if (!targetBox) return;

					elements.forEach((el) => {
						el.addEventListener("mouseenter", (e) => {
							const text =
								e.currentTarget.getAttribute("data-experience");

							if (text) {
								targetBox.innerHTML = text;
								targetBox.classList.remove("opacity-0");
								targetBox.classList.add("opacity-100");
							}

							// Permanently hide the profile hover badge
							if (selector === ".profile-icon") {
								const badge = document.getElementById(
									"profile-hover-badge",
								);
								if (badge) {
									badge.classList.add(
										"opacity-0",
										"pointer-events-none",
									);
									setTimeout(() => {
										badge.style.display = "none";
									}, 300);
								}
							}
						});

						el.addEventListener("mouseleave", () => {
							targetBox.classList.remove("opacity-100");
							targetBox.classList.add("opacity-0");
						});
					});
				};

				bindHover(".tool-icon", "tool-experience-box");
				bindHover(".social-icon", "profile-experience-box");
				bindHover(".profile-icon", "profile-experience-box");
			}

			// 2. YouTube Data Fetching (Fetches once, populates subs, views, & combined totals)
			async function fetchYouTubeData() {
				const subCountEl = document.getElementById("yt-sub-count");
				const viewCountEl = document.getElementById("yt-view-count");
				const combinedEl = document.getElementById("combined-views");

				if (!subCountEl && !viewCountEl && !combinedEl) return;

				try {
					const res = await fetch(
						`https://www.googleapis.com/youtube/v3/channels?part=statistics&forHandle=${CHANNEL_HANDLE}&key=${YT_API_KEY}`,
					);
					const data = await res.json();

					if (data.items && data.items.length > 0) {
						const stats = data.items[0].statistics;
						const subs = Number(stats.subscriberCount) || 0;
						const views = Number(stats.viewCount) || 0;

						if (subCountEl) {
							subCountEl.textContent = subs.toLocaleString();
						}
						if (viewCountEl) {
							viewCountEl.textContent = views.toLocaleString();
						}
						if (combinedEl) {
							const totalCombined = views + INSTAGRAM_FIXED_VIEWS;
							combinedEl.textContent =
								(totalCombined / 1000000).toFixed(1) + "M+";
						}
					}
				} catch (error) {
					console.error("Error fetching YouTube statistics:", error);
				}
			}

			// 3. Instagram View Fetching (Not Working Yet :/   )
			async function fetchInstagramViews() {
				const viewElement = document.getElementById("ig-view-count");
				if (!viewElement) return;

				try {
					const response = await fetch(
						`https://graph.instagram.com/v19.0/${INSTAGRAM_MEDIA_ID}?fields=views,play_count&access_token=${INSTAGRAM_ACCESS_TOKEN}`,
					);
					const data = await response.json();
					const views = data.views || data.play_count;

					if (views !== undefined) {
						viewElement.textContent =
							Number(views).toLocaleString() + "+";
					}
				} catch (error) {
					console.error("Error fetching Instagram views:", error);
				}
			}

			// Initialize all logic
			function runAllScripts() {
				initUIInteractions();
				fetchYouTubeData();
				fetchInstagramViews();
			}

			// Execution Hooks (Works on raw DOM load & Astro view transitions)
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", runAllScripts);
			} else {
				runAllScripts();
			}
			document.addEventListener("astro:page-load", runAllScripts);
		</script>
