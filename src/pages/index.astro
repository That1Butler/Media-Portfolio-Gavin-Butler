	<body class="bg-[url('./micro_carbon.webp')]">
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							// In view: slide in and fade in
							entry.target.classList.remove(
								"opacity-0",
								"-translate-x-12",
							);
							entry.target.classList.add(
								"opacity-100",
								"translate-x-0",
							);
						} else {
							// Out of view: reset back to original state (fades out and shifts back left)
							entry.target.classList.remove(
								"opacity-100",
								"translate-x-0",
							);
							entry.target.classList.add(
								"opacity-0",
								"-translate-x-12",
							);
						}
					});
				},
				{
					threshold: 0.2, // Triggers when 20% of the element is visible
				},
			);

			const target = document.getElementById("reveal-section");
			if (target) observer.observe(target);
		</script>
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							// Slide in & fade in on scroll down
							entry.target.classList.remove(
								"opacity-0",
								"-translate-x-12",
							);
							entry.target.classList.add(
								"opacity-100",
								"translate-x-0",
							);
						} else {
							// Reset (fade out & slide left) when scrolling away
							entry.target.classList.remove(
								"opacity-100",
								"translate-x-0",
							);
							entry.target.classList.add(
								"opacity-0",
								"-translate-x-12",
							);
						}
					});
				},
				{
					threshold: 0.15,
				},
			);

			// Automatically watches all sections using the scroll-reveal-left class
			document
				.querySelectorAll(".scroll-reveal-left")
				.forEach((el) => observer.observe(el));
		</script>
