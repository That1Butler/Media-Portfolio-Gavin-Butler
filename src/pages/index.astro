					expBox.classList.remove("opacity-0");
					expBox.classList.add("opacity-100");
				});

				icon.addEventListener("mouseleave", () => {
					expBox.classList.remove("opacity-100");
					expBox.classList.add("opacity-0");
				});
			});
		</script>
